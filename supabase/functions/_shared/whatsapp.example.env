# =============================================================
# EduSync LMS — WhatsApp API Configuration
# =============================================================
# Copy file ini ke Supabase Secrets atau .env lokal.
# Jangan commit file .env yang berisi credentials asli!
#
# Set via Supabase CLI:
#   supabase secrets set WHATSAPP_PROVIDER=fonnte
#   supabase secrets set WHATSAPP_API_KEY=your-api-key
#   supabase secrets set WHATSAPP_BASE_URL=https://api.fonnte.com
# =============================================================

# Provider WhatsApp API
# Opsi: fonnte | wablas | wa_business | mock
# Gunakan 'mock' untuk development (tidak kirim pesan asli)
WHATSAPP_PROVIDER=mock

# API Key dari provider yang dipilih
# - Fonnte: dapatkan dari https://fonnte.com
# - Wablas: dapatkan dari https://wablas.com
# - wa_business: access token dari Facebook Developer Console
WHATSAPP_API_KEY=your-api-key-here

# Base URL provider (opsional — ada default per provider)
# - Fonnte: https://api.fonnte.com
# - Wablas: https://pati.wablas.com
# - wa_business: https://graph.facebook.com/v18.0
WHATSAPP_BASE_URL=https://api.fonnte.com

# Khusus WhatsApp Business API (Meta)
# Phone Number ID dari Facebook Developer Console
# WHATSAPP_PHONE_NUMBER_ID=123456789

# Webhook secret untuk verifikasi delivery reports (opsional)
# WHATSAPP_WEBHOOK_SECRET=your-webhook-secret
