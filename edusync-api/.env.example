# Copy to .env and fill in values (.env is git-ignored)

# ── Database — Docker self-hosted PostgreSQL ──────────────────────────────────
# For local dev: start with `docker compose up -d postgres`
# Direct connection (for sqlx macros at compile time, or direct psql access):
DATABASE_URL=postgresql://postgres:edusync_local_pass@localhost:5432/edusync

# Via pgBouncer (recommended for production / runtime):
# DATABASE_URL=postgresql://postgres:edusync_local_pass@localhost:5433/edusync

# PostgreSQL password (must match POSTGRES_PASSWORD in docker-compose.yml)
POSTGRES_PASSWORD=edusync_local_pass

# ── JWT secrets (min 32 chars, random hex) ────────────────────────────────────
JWT_SECRET=change-me-min-32-chars-random-hex
JWT_REFRESH_SECRET=change-me-min-32-chars-random-hex

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
RUST_LOG=info
CORS_ORIGINS=http://localhost:5173
ENABLE_OBSERVER=false

# ── Email — defaults to console log when unset (dev mode) ─────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@edusync.dev

# ── OAuth — Phase 1C ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8080

# ── Phase 5: S3-compatible Storage ───────────────────────────────────────────
# MinIO (local dev) — bundled in docker-compose.yml
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_BUCKET=edusync
S3_PUBLIC_URL=http://localhost:9000/edusync

# Cloudflare R2 (production) — uncomment and fill:
# S3_ENDPOINT=https://{ACCOUNT_ID}.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID={R2_ACCESS_KEY_ID}
# S3_SECRET_ACCESS_KEY={R2_SECRET_ACCESS_KEY}
# S3_BUCKET=edusync
# S3_PUBLIC_URL=https://cdn.edusync.dev
