# Copy to .env and fill in values (.env is git-ignored)

# ── Database — Docker self-hosted PostgreSQL ──────────────────────────────────
# For local dev: start with `docker compose up -d postgres`
# Direct connection (for sqlx macros at compile time, or direct psql access):
DATABASE_URL=postgresql://postgres:edusync_local_pass@localhost:5432/edusync

# Via pgBouncer (recommended for production / runtime):
# DATABASE_URL=postgresql://postgres:edusync_local_pass@localhost:5433/edusync

# PostgreSQL password (must match POSTGRES_PASSWORD in docker-compose.yml)
POSTGRES_PASSWORD=edusync_local_pass

# ── JWT secrets (min 32 chars, random hex; must differ from each other) ──────
JWT_SECRET=change-me-min-32-chars-random-hex
JWT_REFRESH_SECRET=change-me-different-from-jwt-secret

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
RUST_LOG=info
CORS_ORIGINS=http://localhost:5173
ENABLE_OBSERVER=false
VIL_PROFILE=dev

# ── Frontend (Vite) — only needed if running the web client in this repo ─────
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080/ws

# ── Email — defaults to console log when unset (dev mode) ─────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=change-me
SMTP_FROM_EMAIL=noreply@edusync.dev

# ── OAuth — Phase 1C ──────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=change-me
OAUTH_REDIRECT_BASE_URL=http://localhost:8080

# ── AI provider (Groq) ────────────────────────────────────────────────────────
GROQ_API_KEY=change-me

# ── Web Push (VAPID) — generate with `npx web-push generate-vapid-keys` ──────
VAPID_PRIVATE_KEY=change-me
VAPID_PUBLIC_KEY=change-me

# ── WhatsApp Cloud API ───────────────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=change-me
WHATSAPP_PHONE_NUMBER_ID=change-me

# ── Phase 5: S3-compatible Storage ───────────────────────────────────────────
# MinIO (local dev) — bundled in docker-compose.yml
# Replace change-me with the MinIO root creds from docker-compose.yml for local dev.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=edusync
S3_PUBLIC_URL=http://localhost:9000/edusync

# Cloudflare R2 (production) — uncomment and fill:
# S3_ENDPOINT=https://{ACCOUNT_ID}.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID={R2_ACCESS_KEY_ID}
# S3_SECRET_ACCESS_KEY={R2_SECRET_ACCESS_KEY}
# S3_BUCKET=edusync
# S3_PUBLIC_URL=https://cdn.edusync.dev
