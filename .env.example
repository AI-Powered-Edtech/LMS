# GEMINI_API_KEY: Required for AI Tutor and Recommendation features.
# Get yours at https://aistudio.google.com/apikey
GEMINI_API_KEY=""

# JWT_SECRET: Required for authentication token signing.
# Generate a strong random string: openssl rand -base64 32
JWT_SECRET=""

# DATABASE_URL: Database connection string.
# SQLite (dev): file:./dev.db
# PostgreSQL (prod): postgresql://user:password@localhost:5432/edusync
DATABASE_URL="file:./dev.db"

# APP_URL: The URL where this app is hosted.
APP_URL="http://localhost:3000"
