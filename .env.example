# ============================================================
# EduSync LMS — Environment Variables
# ============================================================
# Copy file ini ke .env.local lalu isi nilainya:
#   cp .env.example .env.local
#
# JANGAN commit .env.local ke git!
# ============================================================


# ------------------------------------------------------------
# SUPABASE (WAJIB)
# ------------------------------------------------------------
# Dapatkan dari: Supabase Dashboard → Project Settings → API

# Project URL kamu
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co

# Anon / Public key (aman untuk frontend)
VITE_SUPABASE_ANON_KEY=eyJhbGci...


# ------------------------------------------------------------
# AI TUTOR (Opsional)
# ------------------------------------------------------------
# Diperlukan untuk fitur AI Tutor dan Rekomendasi Belajar
# Dapatkan di: https://aistudio.google.com/apikey
GEMINI_API_KEY=


# ------------------------------------------------------------
# AUTH (Opsional — hanya untuk backend/edge functions)
# ------------------------------------------------------------
# Generate dengan: openssl rand -base64 32
JWT_SECRET=


# ------------------------------------------------------------
# DATABASE (Opsional — hanya jika pakai backend terpisah)
# ------------------------------------------------------------
# SQLite  (dev)  : file:./dev.db
# PostgreSQL (prod): postgresql://user:password@localhost:5432/edusync
DATABASE_URL=file:./dev.db


# ------------------------------------------------------------
# APP
# ------------------------------------------------------------
APP_URL=http://localhost:5173
