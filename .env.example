# ============================================================
# EduSync LMS — Environment Variables
# ============================================================
# Copy file ini ke .env lalu isi nilainya:
#   cp .env.example .env
#
# JANGAN commit .env ke git!
# ============================================================


# ------------------------------------------------------------
# SUPABASE (WAJIB)
# ------------------------------------------------------------
# Dapatkan dari: Supabase Dashboard → Project Settings → API

# Project URL kamu
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co

# Anon / Public key (aman untuk frontend)
VITE_SUPABASE_ANON_KEY=eyJhbGci...


# ------------------------------------------------------------
# DEV HELPER (Opsional)
# ------------------------------------------------------------
# Pre-fill password di Quick Login buttons (halaman login)
# Hanya berlaku di environment dev lokal
VITE_DEV_PASSWORD=

# ------------------------------------------------------------
# MONITORING & PUSH NOTIFICATIONS (Opsional)
# ------------------------------------------------------------
# Sentry DSN untuk error tracking
VITE_SENTRY_DSN=

# VAPID Public Key untuk Web Push Notifications
VITE_VAPID_PUBLIC_KEY=


# ------------------------------------------------------------
# EDGE FUNCTION SECRETS
# ------------------------------------------------------------
# Secret ini di-set via Supabase CLI, BUKAN di .env frontend.
# Dokumentasi di sini sebagai referensi tim.
#
# supabase secrets set GROQ_API_KEY=<key> --project-ref <REF>
#
# GROQ_API_KEY        — Untuk AI Tutor & AI Grading (dapatkan di https://console.groq.com)
# SUPABASE_URL        — Otomatis tersedia di Edge Functions
# SUPABASE_ANON_KEY   — Otomatis tersedia di Edge Functions
# SUPABASE_SERVICE_ROLE_KEY — Otomatis tersedia di Edge Functions
# SUPABASE_DB_URL     — Otomatis tersedia di Edge Functions
