{
  "name": "edusync-lms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "vite --host",
    "build": "pnpm run validate && vite build",
    "analyze": "ANALYZE=true vite build",
    "preview": "vite preview",
    "deploy:puter": "pnpm run build && puter site deploy ./dist edusync-lms",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "typecheck:migration-gate": "node scripts/typecheck-migration-gate.mjs",
    "lint": "eslint src/",
    "lint:migration-gate": "pnpm exec eslint src/services/api src/services/auth src/features/courses/api src/features/gradebook/api src/features/gradebook/hooks",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,md}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx,json,md}'",
    "test": "vitest",
    "test:ci": "vitest run --coverage --reporter=default",
    "test:gate3": "pnpm exec vitest run src/features/gradebook/__tests__/gradebookApi.comprehensive.test.ts && cd edusync-api && DATABASE_URL='postgresql://postgres:postgres@127.0.0.1:54322/postgres' cargo check -p edusync-api-server && DATABASE_URL='postgresql://postgres:postgres@127.0.0.1:54322/postgres' cargo test -p edusync-integration-tests --test gate3_api",
    "test:changed": "vitest related --run",
    "check:no-mocks": "node scripts/check-no-mocks.mjs",
    "superbatch:status": "node scripts/superbatch-status.mjs",
    "validate": "pnpm run typecheck && pnpm run lint && pnpm run check:no-mocks && pnpm run test:ci",
    "audit:check": "pnpm audit --audit-level=moderate",
    "audit:check:local": "pnpm audit --audit-level=moderate || true",
    "audit:fix": "pnpm audit fix",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --project-token=$CHROMATIC_PROJECT_TOKEN --only-changed",
    "prepare": "husky",
    "load:smoke": "k6 run tests/load/smoke.js",
    "load:stress": "k6 run tests/load/stress.js",
    "perf:lighthouse": "npx lhci autorun --config=lighthouserc.json 2>/dev/null || npx lighthouse http://localhost:5173 --output=json --output-path=./lighthouse-report.json --chrome-flags='--headless'",
    "check:circular": "madge --circular --extensions ts,tsx src/",
    "check:unused": "knip",
    "bundlesize": "bundlesize",
    "tsc": "tsc --noEmit"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^5.4.0",
    "@sentry/react": "^10.57.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-virtual": "^3.14.2",
    "@types/papaparse": "^5.3.14",
    "@types/qrcode": "^1.5.6",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.10",
    "hls.js": "^1.6.16",
    "i18next": "^26.3.1",
    "katex": "^0.17.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.40.0",
    "papaparse": "^5.5.3",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "react-i18next": "^17.0.8",
    "react-is": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "valibot": "^1.4.1",
    "vite": "^6.4.2",
    "web-vitals": "^5.3.0",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.61.0",
    "@rollup/plugin-terser": "^1.0.0",
    "@sentry/vite-plugin": "^5.3.0",
    "@storybook/addon-themes": "^10.4.5",
    "@storybook/react": "^10.4.5",
    "@storybook/react-vite": "^10.4.5",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.9",
    "bundlesize2": "^0.0.35",
    "cors": "^2.8.6",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "express": "^5.2.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jest-axe": "^10.0.0",
    "jsdom": "^29.1.1",
    "knip": "^6.16.1",
    "lint-staged": "^16.4.0",
    "madge": "^8.0.0",
    "prettier": "^3.8.4",
    "puppeteer-core": "^24.42.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^10.4.5",
    "typescript": "~5.8.2",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": ">=7.0.5",
      "picomatch": ">=4.0.4",
      "brace-expansion": ">=5.0.5",
      "lodash": ">=4.18.0",
      "postcss": "^8.5.10",
      "fast-uri": ">=3.1.2",
      "@babel/plugin-transform-modules-systemjs": ">=7.29.4",
      "basic-ftp": ">=5.3.1",
      "ip-address": ">=10.1.1"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml}": [
      "prettier --write"
    ]
  },
  "bundlesize": [
    {
      "path": "./dist/assets/index-*.js",
      "maxSize": "150 kB"
    },
    {
      "path": "./dist/assets/react-core-*.js",
      "maxSize": "90 kB"
    },
    {
      "path": "./dist/assets/vendor-router-*.js",
      "maxSize": "40 kB"
    },
    {
      "path": "./dist/assets/vendor-query-*.js",
      "maxSize": "30 kB"
    },
    {
      "path": "./dist/assets/vendor-motion-*.js",
      "maxSize": "80 kB"
    },
    {
      "path": "./dist/assets/vendor-lucide-*.js",
      "maxSize": "80 kB"
    },
    {
      "path": "./dist/assets/vendor-sentry-*.js",
      "maxSize": "120 kB"
    },
    {
      "path": "./dist/assets/*.css",
      "maxSize": "100 kB"
    }
  ]
}
